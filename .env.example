# Pulso Ignite — variables de entorno
# Copiá este archivo a .env.local para desarrollo local, o cargalas en Vercel
# (Project Settings -> Environment Variables) para producción.
#
# Si estas 5 variables de Google Ads NO están todas presentes, la app funciona
# igual con datos de ejemplo (mock) — ver lib/mockData.ts. Nunca se rompe el
# deploy por falta de credenciales.

# --- Google Ads API ---
# Developer Token real, de Google Ads UI -> Herramientas y configuración -> Centro de API.
# OJO: un token obtenido del "API Explorer" de Google (el que te da un access_token
# de prueba de corta duración al tocar "Execute") NO es esto y NO sirve acá.
# Verificá que el nivel de acceso de tu developer token sea "Basic" o "Standard"
# (no "Test account only") si necesitás traer datos de cuentas de clientes reales.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Cliente OAuth2 (Google Cloud Console -> APIs & Services -> Credentials).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token de larga duración, obtenido una vez completando el consentimiento
# OAuth2 con un usuario que tenga acceso a las cuentas de Google Ads a integrar.
GOOGLE_ADS_REFRESH_TOKEN=

# Customer ID (sin guiones) de la cuenta MCC/administrador que agrupa a los
# clientes, si aplica. Dejar vacío si no operás con una cuenta administradora.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Mapeo cliente interno -> Customer ID de Google Ads (sin guiones), separado por comas
# clave:valor. Ejemplo: norte:1234567890,andes:2345678901,terra:3456789012
GOOGLE_ADS_CUSTOMER_MAP=

# --- Windsor.ai (capa de ingesta elegida — ver docs/explanation/arquitectura-de-datos.md) ---
# Tiene prioridad sobre las variables de Google Ads de arriba: si WINDSOR_API_KEY
# está presente, /api/spend usa lib/windsor.ts y ni siquiera llega a mirar las
# credenciales de Google Ads directo.
# API key simple (no OAuth) — Windsor.ai UI -> Account -> API Key.
# Ya está cargada en Vercel (Production/Preview/Development) desde la cuenta
# marketing@taquion.com.ar — para desarrollo local copiala también acá.
WINDSOR_API_KEY=

# OPCIONALES. Por defecto, con solo WINDSOR_API_KEY, el dashboard ya trae y
# muestra TODAS las cuentas conectadas en Windsor.ai (Google Ads y Meta Ads
# por ahora), cada una como su propia fila (nombre y gasto reales, sin
# objetivo/media plan todavía). Estas variables sirven solo para el caso
# contrario: pisar el spend de un cliente mock puntual
# (norte/andes/terra/metrovoz) con una cuenta real específica, cuando exista
# ese mapeo de negocio. Formato cliente_interno:account_id, separado por comas.
# Ejemplo: norte:1234567890,andes:2345678901
WINDSOR_GOOGLE_ADS_ACCOUNT_MAP=
WINDSOR_META_ACCOUNT_MAP=
